{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bilibili Client",
  "identifier": "com.example.bilibili-client",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../app-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bilibili Client",
        "url": "index.html?v=2",
        "width": 1700,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --enable-logging=stderr --v=1 --log-level=0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://talktime.oss-cn-shanghai.aliyuncs.com/doc/bl/bl/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
