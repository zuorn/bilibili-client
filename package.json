{
  "name": "bilibili-client",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 >nul && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "clean": "rimraf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Bilibili client",
  "dependencies": {
    "axios": "^1.15.2",
    "node-mpv": "^1.5.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "rimraf": "^6.1.3"
  },
  "build": {
    "appId": "com.example.bilibili-client",
    "productName": "Bilibili Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "src/**/*",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}
