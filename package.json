{
  "name": "bilibili-client",
  "version": "0.0.1",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 >nul && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "clean": "rimraf dist"
  },
  "keywords": [],
  "author": "Zuorn",
  "license": "ISC",
  "description": "Bilibili client",
  "dependencies": {
    "axios": "^1.15.2",
    "chalk": "^4.1.2",
    "node-mpv": "^1.5.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.example.bilibili-client",
    "productName": "Bilibili Client",
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-mpv/**/*"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "src/**/*",
      "icon.png",
      "package.json",
      "cookieManager.js"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "include": "install/installer.nsh",
      "license": "LICENSE",
      "menuCategory": true,
      "runAfterFinish": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}
