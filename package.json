{
  "name": "bilibili-client",
  "version": "0.0.1",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 >nul && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder && npm run clean:dist",
    "build:win": "electron-builder --win && npm run clean:dist",
    "build:mac": "electron-builder --mac && npm run clean:dist",
    "build:linux": "electron-builder --linux && npm run clean:dist",
    "clean": "rimraf dist",
    "clean:dist": "rimraf dist/win-unpacked dist/win-ia32-unpacked dist/mac dist/mac-arm64 dist/linux-unpacked dist/builder-debug.yml dist/builder-effective-config.yaml"
  },
  "keywords": [],
  "author": "Zuorn",
  "license": "ISC",
  "description": "Bilibili client",
  "dependencies": {
    "axios": "^1.15.2",
    "chalk": "^4.1.2",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "js-yaml": "^4.1.1",
    "node-mpv": "^1.5.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.example.bilibili-client",
    "productName": "Bilibili Client",
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "zuorn",
      "repo": "bilibili-client"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/node-mpv/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "src/**/*",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "include": "install/installer.nsh",
      "license": "LICENSE",
      "menuCategory": true,
      "runAfterFinish": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}